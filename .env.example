# Скопируйте в .env и заполните. Один файл на весь проект.
#   copy .env.example .env
#   docker compose up -d --build

# --- Обязательные ---

# Пароль Postgres
DB_PASSWORD=

# Токен от @BotFather. После оплаты ЮKassa открывает этого бота.
TELEGRAM_BOT_TOKEN=

# Общий секрет бота и backend. Длинная случайная строка.
BOT_INTERNAL_TOKEN=

# Пароль входа на /admin-panel
ADMIN_PASSWORD=

# Адрес сайта, например https://example.com
# Документы: {PUBLIC_BASE_URL}/privacy, /consent, /offer
# Вебхук ЮKassa: {PUBLIC_BASE_URL}/api/yookassa/webhook
PUBLIC_BASE_URL=

# Кабинет ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Необязательные ---

DB_USER=aimarket
DB_NAME=aimarket
DB_HOST=localhost
DB_PORT=5432

# Имя бота без @. Если пусто, берётся из токена.
TELEGRAM_BOT_USERNAME=

# Для запуска бота без Docker. В Docker подставится само.
BACKEND_URL=http://127.0.0.1:8000

# Корневой ключ router.cheap — для создания ключей и сверки баланса.
# Можно задать здесь или в админке (/admin-panel). Для истории трат не нужен:
# расходы подтягиваются по секрету дочернего ключа (/api/log/token).
ROUTER_ROOT_KEY=
ROUTER_BASE_URL=https://router.cheap

# Копеек за $1 лимита. 0 — цену задают в админке.
USD_PRICE_KOPECKS=0

# Секрет подписи сессии админки. Если пусто, выводится из пароля.
ADMIN_TOKEN_SECRET=

# Секрет подписи сессий личного кабинета на сайте. Если пусто, выводится из ADMIN_TOKEN_SECRET.
WEB_SESSION_SECRET=
WEB_SESSION_TTL_DAYS=30
# Сколько дней действует ссылка для входа из письма.
EMAIL_LOGIN_TTL_DAYS=7

# SMTP для писем с ключом доступа после оплаты на сайте. Пустой SMTP_HOST — письма не шлём.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (порт 587), ssl (порт 465) или none
SMTP_SECURITY=starttls
# Адрес отправителя. Если пусто, берётся SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=Aimarket

# Как часто сверять лимит с router.cheap, секунды.
SYNC_INTERVAL_SEC=60

# Почта в чеке, если в ЮKassa включены чеки. Иначе оставьте пустым.
YOOKASSA_RECEIPT_EMAIL=
# 1 — без НДС
YOOKASSA_VAT_CODE=1
