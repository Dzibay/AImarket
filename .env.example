# Корень репозитория. Для Docker:
#   copy .env.example .env
#   copy backend\.env.example backend\.env
#   copy bot\.env.example bot\.env
#   docker compose up -d --build

POSTGRES_USER=aimarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aimarket

# Токен бота от @BotFather. После оплаты ЮKassa открывает этого бота.
TELEGRAM_BOT_TOKEN=
# Если пусто, имя бота берётся из токена. Можно указать вручную, без @.
TELEGRAM_BOT_USERNAME=

# Общий секрет: бот шлёт его в заголовке, backend пускает только с ним
BOT_INTERNAL_TOKEN=change-me-long-random

# Корневой ключ кабинета router.cheap (тот, которым входите в dashboard).
# Покупателям его не передавать.
ROUTER_BASE_URL=https://router.cheap
ROUTER_ROOT_KEY=

# Сколько копеек брать с покупателя за $1 лимита на ключе. 0 — пока цену не зададут в админке.
USD_PRICE_KOPECKS=0

# Адрес сайта, который бот вставляет в ссылку на оферту. Например https://example.com
PUBLIC_BASE_URL=

# Пароль входа на /admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-long-random

# ЮKassa: shopId и секретный ключ. Вебхук: {PUBLIC_BASE_URL}/api/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Почта покупателя в чеке, если в кабинете ЮKassa включены чеки. Иначе оставьте пустым.
YOOKASSA_RECEIPT_EMAIL=
# 1 — без НДС
YOOKASSA_VAT_CODE=1
